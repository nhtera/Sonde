<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="sonde"
        Arguments=""
        InstallLocation="C:\Program Files\The Sonde Authors\Sonde">
    </Installer>
    <PackageInformation
        PackageName="Sonde"
        PackageDisplayName="Sonde"
        PublisherName="CN=The Sonde Authors"
        PublisherDisplayName="The Sonde Authors"
        Version="0.1.0.0"
        PackageDescription="A sonde application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.sonde.desktop"
                Description="A sonde application"
                DisplayName="Sonde"
                ExecutableName="sonde"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Sonde</DisplayName>
            <PublisherDisplayName>The Sonde Authors</PublisherDisplayName>
            <Description>A sonde application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="sonde.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
