# Build output
/dist/
/bin/
/desktop/bin/
/desktop/.task/
/desktop/build/linux/appimage/build/
/desktop/build/windows/nsis/MicrosoftEdgeWebview2Setup.exe
# Update signing private keys (update-manifest genkey) are made offline;
# never commit one here.
/desktop/internal/update/keys/*.key
*.test
coverage.*

# OS
.DS_Store

# Conformance harness runtime output: server logs, sockets, __pycache__,
# and whatever the vendored scripts themselves write (build/ is where they
# expect to). The venv itself lives under the user cache dir, not here.
testdata/conformance/hurl/.venv/
testdata/conformance/hurl/build/
testdata/conformance/hurl/**/__pycache__/

# Plans and research stay private; public design lives in docs/
/plans/

# Agent config and memory stay private
/.claude/
.env.*

# The output option of results-api/export.hurl (48 MiB).
/desktop/testdata/results-api/exports/*
!/desktop/testdata/results-api/exports/.gitkeep

# Website (site/): dependencies, build output and generated files.
# content/ is generated from docs/ by the sync step.
/site/node_modules/
/site/dist/
/site/.output/
/site/.tanstack/
/site/.source/
/site/src/routeTree.gen.ts
/site/*.tsbuildinfo
/site/content/
/site/deploy/node_modules/
/site/.cloudflare/
/site/.wrangler/

# The website's screenshots before they are optimized (make site-screens).
/desktop/frontend/marketing-shots/
