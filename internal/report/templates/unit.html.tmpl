<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'">
<title>{{.Filename}} &mdash; Sonde test report</title>
<style>
:root{color-scheme:light dark}
body{font-family:ui-sans-serif,system-ui,sans-serif;margin:2rem;background:#fff;color:#1b1f24}
h1{font-size:1.3rem}
h2{font-size:1.05rem;margin-top:2rem}
h3{font-size:.95rem}
pre{background:#f6f8fa;padding:.75rem;overflow-x:auto;white-space:pre-wrap;word-break:break-word;border-radius:6px}
code{background:#f6f8fa;padding:.1rem .3rem;border-radius:4px}
.success{color:#116329}
.failure{color:#a40e26}
table{border-collapse:collapse;margin:.5rem 0 1rem;width:100%}
th,td{border-bottom:1px solid #d0d7de;padding:.3rem .6rem;text-align:left;vertical-align:top}
.entry{border:1px solid #d0d7de;border-radius:6px;padding:1rem;margin-bottom:1rem}
a{color:#0969da}
</style>
</head>
<body>
<p><a href="../index.html">&larr; all files</a></p>
<h1>{{.Filename}} &mdash; <span class="{{if .Success}}success{{else}}failure{{end}}">{{if .Success}}PASS{{else}}FAIL{{end}}</span></h1>
<p>{{.TimeMS}} ms &mdash; run at {{.RunAt}}</p>

{{if .ParseError}}<h2>Parse error</h2>
<pre>{{.ParseError}}</pre>{{end}}

<h2>Source</h2>
<pre>{{.Source}}</pre>

{{if .Entries}}<h2>Entries</h2>{{end}}
{{range .Entries}}<div class="entry">
<h3>Entry {{.Index}} (line {{.Line}})</h3>
<p><code>{{.CurlCmd}}</code></p>
{{range .Calls}}<table>
<tr><th>Request</th><td>{{.Request.Method}} {{.Request.URL}}</td></tr>
{{range .Request.Headers}}<tr><td></td><td>{{.Name}}: {{.Value}}</td></tr>{{end}}
<tr><th>Response</th><td>{{.Response.HTTPVersion}} {{.Response.Status}}</td></tr>
{{range .Response.Headers}}<tr><td></td><td>{{.Name}}: {{.Value}}</td></tr>{{end}}
{{if .BodyPreview}}<tr><th>Body</th><td><pre>{{.BodyPreview}}</pre></td></tr>{{end}}
</table>
{{end}}
{{with .GRPC}}<p>gRPC status: <code>{{.Status}}</code> ({{.Code}}){{if .Message}}: {{.Message}}{{end}}</p>{{end}}
{{with .Stream}}<table>
<thead><tr><th colspan="4">Stream: {{.Protocol}}, {{.Sent}} sent, {{.Received}} received{{if .StopReason}}, stopped by {{.StopReason}}{{end}}</th></tr>
<tr><th>Time (ms)</th><th>Direction</th><th>Event</th><th>Data</th></tr></thead>
{{range .Messages}}<tr><td>{{.Time}}</td><td>{{.Direction}}</td><td>{{.Event}}{{if .ID}} (id {{.ID}}){{end}}</td><td><pre>{{if .Binary}}base64: {{end}}{{.Data}}</pre></td></tr>{{end}}
{{if .Omitted}}<tr><td colspan="4">&hellip; {{.Omitted}} more messages</td></tr>{{end}}
</table>{{end}}
{{if .Asserts}}<table>
<thead><tr><th>Line</th><th>Result</th><th>Message</th></tr></thead>
{{range .Asserts}}<tr><td>{{.Line}}</td><td class="{{if .Success}}success{{else}}failure{{end}}">{{if .Success}}ok{{else}}failed{{end}}</td><td>{{if .Message}}<pre>{{.Message}}</pre>{{end}}</td></tr>{{end}}
</table>{{end}}
{{if .Captures}}<table>
<thead><tr><th>Capture</th><th>Value</th></tr></thead>
{{range .Captures}}<tr><td>{{.Name}}</td><td>{{.Value}}</td></tr>{{end}}
</table>{{end}}
{{if .RuntimeErrors}}<table>
<thead><tr><th>Error</th></tr></thead>
{{range .RuntimeErrors}}<tr><td><pre>{{.}}</pre></td></tr>{{end}}
</table>{{end}}
</div>
{{end}}
</body>
</html>
