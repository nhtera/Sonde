== sonde.yaml
version: 1
environments:
  collection:
    variables:
      base_url: http://localhost:8080
      order_id: ord_1093
      product_id: p-42
      sku: TEA-EARL-250
      tenant: eu-1
defaults:
  env: collection
warning unsupported: path variable :cart_id has no value; set cart_id before running
warning unsupported: path variable :refund_id has no value; set refund_id before running
