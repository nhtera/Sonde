== sonde.yaml
version: 1
environments:
  collection:
    variables:
      base_url: https://api.example.test
      user_id: "42"
    secrets_files:
      - secrets/collection.secrets
  dev:
    variables:
      base_url: https://dev.example.test
      token: dev-token-not-secret
      user_id: "42"
      widget_name: gadget
    secrets_files:
      - secrets/dev.secrets
  prod:
    variables:
      base_url: https://api.example.test
      user_id: "42"
    secrets_files:
      - secrets/prod.secrets
defaults:
  env: dev
skipped Users/Disabled request: disabled
skipped Empty: empty folder
warning secret: collection variable "api_key" is a secret; add its value to the environment's secrets file
warning script: collection: prerequest script kept as a comment, not executed
warning script: Users/Get user: test script kept as a comment, not executed
warning secret: Dev: variable "admin_password" is a secret; add its value to the environment's secrets file
warning secret: Prod: variable "token" is a secret; add its value to the environment's secrets file
