== Users/Get user
# prerequest script (never executed):
# console.log('collection prerequest')
# Get user
# test script (never executed):
# pm.response.to.have.status(200);
GET {{base_url}}/users/{{user_id}}
X-Trace: {{newUuid}}
Authorization: Bearer {{token}}
HTTP 200
== Admin/Health
# Health
GET {{base_url}}/health
== Create widget
# Create widget
POST {{base_url}}/widgets
Content-Type: application/json
[BasicAuth]
admin: {{admin_password}}
{"name": "{{widget_name}}", "count": 1}
== Upload
# Upload
POST {{base_url}}/upload
Authorization: Bearer {{token}}
[Multipart]
title: {{title}}
file: file,./photo.png;
== Legacy form
# Legacy form
POST {{base_url}}/legacy
Authorization: Bearer {{token}}
[Form]
a: 1
b: {{b}}
