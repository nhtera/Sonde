== Digest
# Digest
GET {{base_url}}/digest
[BasicAuth]
user: {{digest_password}}
[Options]
digest: true
== NTLM
# NTLM
GET {{base_url}}/ntlm
[BasicAuth]
domain\\user: {{ntlm_password}}
[Options]
ntlm: true
== AWS SigV4
# AWS SigV4
GET {{base_url}}/aws
X-Amz-Security-Token: {{aws_session_token}}
[BasicAuth]
AKIDEXAMPLE: {{aws_secret}}
[Options]
aws-sigv4: aws:amz:us-east-1:execute-api
== API key in query
# API key in query
GET {{base_url}}/apikey
[Query]
api_key: {{api_key}}
== OAuth2
# OAuth2
GET {{base_url}}/oauth2
== sonde.yaml
version: 1
environments:
  collection: {}
defaults:
  env: collection
warning unsupported-auth: Digest: sonde cannot send digest auth yet; this request fails until it can
warning unsupported-auth: NTLM: sonde cannot send ntlm auth yet; this request fails until it can
warning unsupported-auth: AWS SigV4: sonde cannot send awsv4 auth yet; this request fails until it can
warning unsupported-auth: OAuth2: auth type "oauth2" has no Sonde equivalent; add it by hand
