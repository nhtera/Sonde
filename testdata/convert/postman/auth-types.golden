== Digest
# Digest
GET {{base_url}}/digest
[Options]
user: user:{{digest_password}}
digest: true
== NTLM
# NTLM
GET {{base_url}}/ntlm
[Options]
user: domain\\user:{{ntlm_password}}
ntlm: true
== AWS SigV4
# AWS SigV4
GET {{base_url}}/aws
X-Amz-Security-Token: {{aws_session_token}}
[Options]
user: AKIDEXAMPLE:{{aws_secret}}
aws-sigv4: aws:amz:us-east-1:execute-api
== API key in query
# API key in query
GET {{base_url}}/apikey
[Query]
api_key: {{api_key}}
== OAuth2
# OAuth2
GET {{base_url}}/oauth2
== sonde.yaml
version: 1
environments:
  collection: {}
defaults:
  env: collection
warning unsupported-auth: OAuth2: auth type "oauth2" has no Sonde equivalent; add it by hand
