GET https://example.com/literal
[Options]
user: admin:literal-pass

GET https://example.com/templated
[Options]
user: admin:{{PASSWORD}}

GET https://example.com/empty-password
[Options]
user: admin:

GET https://example.com/no-password
[Options]
user: admin
warning unsupported: shell variable $PASSWORD became {{PASSWORD}}; set it with --variable or sonde.yaml
warning secret: curl: -u wrote a password in plain text; consider --secret and {{password}}
